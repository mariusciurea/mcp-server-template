# Copy this file to .env and fill in real values. Never commit the real .env file.

# Secret key used to sign JWT tokens. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Dummy admin account used to log in and get a JWT (no user database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Rate limit applied to every endpoint, slowapi format: "<count>/<period>"
RATE_LIMIT=10/minute
